# Copy to .env and fill in. Never commit .env. Never log these values.

# Async SQLAlchemy 2.0 with the psycopg 3 driver, used from here on.
DATABASE_URL=postgresql+psycopg://audit:audit@localhost:5432/audit
REDIS_URL=redis://localhost:6379/0

# Provider keys (accessed only via app/llm/client.py)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=

# Audit defaults
DEFAULT_COST_CAP_USD=0.75
