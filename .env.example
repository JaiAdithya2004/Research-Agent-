# Copy to .env and fill in. Never commit .env. Never log these values.

# Async SQLAlchemy 2.0 with the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://audit:audit@localhost:5432/audit
REDIS_URL=redis://localhost:6379/0

# Provider keys (accessed only via app/llm/client.py)
GEMINI_API_KEY=
OPENAI_API_KEY=
# OpenRouter: check it with  uv run python -m app.llm.check_key  (costs nothing)
OPENROUTER_API_KEY=

# API keys are stored as HMAC-SHA256 hashes. The pepper is required; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it invalidates every issued key. Create a key: uv run python -m app.auth create --name dev
API_KEY_PEPPER=

# Limits
RATE_LIMIT_DEFAULT_PER_MIN=60
DEFAULT_COST_CAP_USD=0.75

# "arq" (Redis worker, production) or "inprocess" (single process, local tinkering only)
QUEUE_BACKEND=arq
READY_TIMEOUT_S=2

# Observability. All optional; with no keys, tracing and error reporting are off.
# Langfuse variable names are those of SDK v5; check your SDK version's docs if traces do not appear.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Set to 1 to send prompts and answers to Langfuse. Off by default: pages are untrusted data.
LANGFUSE_CAPTURE_CONTENT=0
SENTRY_DSN=
APP_ENV=development

# Seconds between worker polls of Redis (idle polling uses Redis commands; free tiers count them)
WORKER_POLL_DELAY_S=5
